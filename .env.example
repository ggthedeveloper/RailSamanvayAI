# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/railway_db
CORS_ORIGINS=http://localhost:5174

# Frontend build-time setting. Set this to the deployed Render API URL.
VITE_API_BASE_URL=https://railsamanvay-api.onrender.com

# API Settings
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=supersecretkey
DEBUG=True

# ML/Models
MODEL_REGISTRY_PATH=./ml/models

# Optimization
SOLVER_TIME_LIMIT_SECONDS=60
MAX_BLOCK_DURATION_MINUTES=240

# Frontend
VITE_API_BASE_URL=http://localhost:8000
